# Google Gemini
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
# Optional second key; retryable failures rotate to it.
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.1-flash-lite

# Hedging duplicates slow requests; keep it enabled at a conservative value.
HEDGE_AFTER_MS=1500

PORT=8787

# Local speech-to-text container (server/voice)
WHISPER_URL=http://localhost:8790
